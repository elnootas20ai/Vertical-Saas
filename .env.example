# ── Servidor ────────────────────────────────────────────────────────────────────
# Desarrollo: el puerto del front lo define vite.config.ts (por defecto 3015).
VITE_HOST=0.0.0.0
VITE_PORT=3015
VITE_API_URL=https://api.udar.app
VITE_API_HOST=api.udar.app
VITE_API_PORT=443

# ── CouchDB ─────────────────────────────────────────────────────────────────────
# Backend y scripts (create-admin.js, seed-admin.js, Express): COUCHDB_* sin prefijo VITE_
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=CAMBIA_ESTO
# Prefijo de bases `*-sales`, `*-leads`, etc. (debe coincidir con VITE_COUCHDB_DB en build)
COUCHDB_DB=mi_app
# Front (build-time): si las APIs usan proxy con cabeceras x-couch-*, alinea usuario/clave/DB
VITE_COUCHDB_URL=http://localhost:5984
VITE_COUCHDB_USER=admin
VITE_COUCHDB_PASSWORD=CAMBIA_ESTO
VITE_COUCHDB_DB=mi_app

# ── OpenAI ──────────────────────────────────────────────────────────────────────
# Usar OPENAI_API_KEY (sin prefijo VITE_) para que no se exponga al frontend
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# ── Seguridad JWT ────────────────────────────────────────────────────────────────
# Generar con: node -e "require('crypto').randomBytes(48).toString('base64')|console.log"
JWT_SECRET=GENERA_CON_openssl_rand_base64_48
JWT_REFRESH_SECRET=GENERA_CON_openssl_rand_base64_48_DIFERENTE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Bloqueo de cuenta (A-02) ─────────────────────────────────────────────────────
# Número de intentos fallidos antes del primer bloqueo (por defecto: 5)
MAX_LOGIN_ATTEMPTS=5
# Duración del primer bloqueo en minutos (por defecto: 15). Escala ×4 y ×96 en bloqueos siguientes.
LOCK_DURATION_MINUTES=15

# ── API Tokens (A-09) ────────────────────────────────────────────────────────────
# Máximo de días de expiración permitidos al crear/rotar un token (0 = sin límite)
API_TOKEN_MAX_EXPIRY_DAYS=365

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma (sin espacios)
# Producción típica udar + localhost/dev según necesitéis
ALLOWED_ORIGINS=https://udar.app,https://www.udar.app,https://api.udar.app
# Opcional: permitir subdominios HTTPS (ej. staging.tudominio.com) sin listarlos uno a uno
# ALLOWED_ORIGIN_SUFFIXES=tudominio.com

# ── Email ─────────────────────────────────────────────────────────────────────────
# Opción 1: Resend
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=noreply@udar.app

# Opción 2: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu@gmail.com
# SMTP_PASS=tu-app-password
# SMTP_FROM=App <tu@gmail.com>

# ── Pasarela de pago (MONEI) ──────────────────────────────────────────────────────
# Clave API de MONEI como fallback. Los usuarios pueden configurar sus propios
# tokens (test/live) desde Configuración > Facturación > Pasarela de pago.
MONEI_API_KEY=
# Alias legacy (se usa si MONEI_API_KEY está vacía)
# TOKEN_MONEY=

# ── Google Maps / Places Autocomplete ─────────────────────────────────────────
# Clave API con Places API (New) habilitada.
# Obtener en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# ── URL pública ───────────────────────────────────────────────────────────────────
APP_URL=https://udar.app
# Al tener dominio/API definitivos: actualiza APP_URL, VITE_API_URL y ALLOWED_ORIGINS;
# rebuild del front (VITE_*). CouchDB en red pública: COUCHDB_URL=https://host… y TLS;
# preferible que Couch solo sea accesible desde el servidor (127.0.0.1) y no exponerlo.
