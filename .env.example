# ── Servidor ────────────────────────────────────────────────────────────────────
# Desarrollo local: alinear PORT del Express con VITE_API_PORT (típico 3001).
# Arranque recomendado: npm run dev:local  (front 3015 + back 3001 + proxy /api)
PORT=3001
# Desarrollo: el puerto del front lo define vite.config.ts (por defecto 3015).
# Proxy /api en Vite apunta a VITE_API_* — alinear con PORT del Express local (típico 3001).
VITE_HOST=0.0.0.0
VITE_PORT=3015
# Same-origin detrás de Nginx (recomendado en prod): rutas /api sin puerto en el navegador
VITE_API_URL=/api
# App nativa Capacitor (iOS/Android): origen API si VITE_API_URL=/api (WebView no comparte origen con el backend)
VITE_NATIVE_API_ORIGIN=https://vertialapp.com
#
# ── APK Android (Capacitor, solo android/) ─────────────────────────────────────
# Prueba en móvil (sin Play Store):  npm run cap:android:apk:debug
# Play Store (firma release):         npm run cap:android:keystore  (una vez)
#                                     npm run cap:android:apk:release
# Abrir proyecto en Android Studio:  npm run cap:android
# La APK lleva dist/ embebido; NO uses CAPACITOR_SERVER_URL salvo CI explícito.
# Push Android opcional: google-services.json en android/app/ + FIREBASE_SERVER_KEY en servidor.
# Sin Firebase en el APK, deja VITE_ANDROID_FCM_ENABLED sin definir (evita crash al aceptar notificaciones).
# Cuando tengas google-services.json: VITE_ANDROID_FCM_ENABLED=true en el build del APK.
# VITE_ANDROID_FCM_ENABLED=true
# Solo necesarios si VITE_API_URL es una URL absoluta vacía en dev antiguo; el proxy de Vite usa estos contra el backend:
VITE_API_HOST=127.0.0.1
VITE_API_PORT=3001
# Dev opcional: API directa sin proxy → VITE_API_URL=http://127.0.0.1:3001

# ── CouchDB ─────────────────────────────────────────────────────────────────────
# Backend y scripts (npm run create-admin, seed-admin.js, Express): COUCHDB_* sin prefijo VITE_
# Solo origen (sin usuario/contraseña en la URL; fetch del runtime lo rechaza).
COUCHDB_URL=http://127.0.0.1:5984
# Solo Couch en local: npm run couch:up  (deploy/docker-compose.couch-local.yml). Espera tras arrancar Node: COUCH_WAIT_ATTEMPTS / COUCH_WAIT_MS opcional en .env
# Docker Compose (deploy/docker-compose.scaleway.yml): el contenedor `app` usa por defecto
# http://couchdb:5984 (nombre del servicio). Tu COUCHDB_URL del .env suele ser 127.0.0.1 o la IP
# para Fauxton/scripts en el host; eso NO debe llegar al contenedor. Opcional si Couch no está en Compose:
# COUCHDB_URL_APP=http://otro-host:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=CAMBIA_ESTO
# Prefijo de bases `*-sales`, `*-leads`, etc. (debe coincidir con VITE_COUCHDB_DB si lo usas en el front)
COUCHDB_DB=vertial
# Inventario vehículos: por defecto `{COUCHDB_DB}-vehicles`. Sigue leyendo la base legacy `vehicles` como respaldo.
# VITE_VEHICLES_DB=vertial-vehicles
# Solo prefijo de nombre de BD para rutas `/api/couch/...` (ej. vertial-quotes). Sin URL ni credenciales en el navegador.
VITE_COUCHDB_DB=vertial

# ── Cuenta admin del SaaS sin registro web (BD `accounts`; rol Admin → /saas/admin) ──
# Producción (NODE_ENV=production): copia estas claves a .env.production si ese archivo existe;
# si solo están en .env pero .env.production define la misma variable vacía/distinta, gana .env.production.
#
# Opción A — al arrancar el backend: crea la cuenta si no existe
# SAAS_AUTO_BOOTSTRAP=true
# Si la cuenta ya existe y quieres forzar la clave del .env una vez: SAAS_BOOTSTRAP_FORCE_SYNC=true (luego quítalo)
# SAAS_LOGIN_EMAIL=tu@correo.com
# SAAS_LOGIN_PASSWORD=minimo_8_caracteres
# SAAS_LOGIN_FIRST_NAME=Nombre
# SAAS_LOGIN_LAST_NAME=Apellido
# SAAS_LOGIN_COMPANY=Empresa
#
# uriel@admin.com = solo login manual (OTP Gmail) cuando algo falla. NO lo uses en smoke/deploy.
#
# Opción B — manual por SSH (recomendado en prod): npm run create-admin
#   (equivale a npm run saas:bootstrap; mismas SAAS_LOGIN_* + COUCHDB_*)
#
# CouchDB vacío o servidor nuevo: crea la BD `accounts` y el usuario admin de login
#   npm run couch:recover-admin
# (mismas variables COUCHDB_* + SAAS_LOGIN_*; COUCHDB_URL desde el host del VPS:
#  http://127.0.0.1:5984 si Couch expone 5984; desde tu PC remoto: http://IP:5984)
#
# Plugin burbuja (Cursor): mismo email que SUPERADMIN_EMAIL en SaasRoot.tsx

# ── Smoke test SaaS (npm run smoke:saas · npm run check:saas) ─────────────────
# Cuenta de PRUEBA (no admin). Deploy la usa si está definida; si no, solo build.
# SMOKE_SAAS_EMAIL=prueba@tudominio.com
# SMOKE_SAAS_PASSWORD=minimo_8_caracteres
# Local: VERIFY_API_BASE=http://127.0.0.1:3001 (con backend:dev en marcha)
# Prod:  VERIFY_API_BASE=https://vertialapp.com
# SMOKE_SAAS_MIN_STORES=1   # opcional: exige ≥1 tienda en cada negocio delivery
# SMOKE_SAAS_SKIP_FINANCE=1  # omitir GET /api/finance/:userId
#
# Seguridad del Plugin API (/api/plugin)
# - En producción está DESACTIVADO por defecto.
# - Para activarlo explícitamente (solo si sabes lo que haces): ENABLE_PLUGIN=true
# - En desarrollo, por defecto solo acepta llamadas desde localhost; si necesitas LAN: PLUGIN_ALLOW_REMOTE=true
ENABLE_PLUGIN=false
PLUGIN_ALLOW_REMOTE=false

# ── OpenAI ──────────────────────────────────────────────────────────────────────
# Usar OPENAI_API_KEY (sin prefijo VITE_) para que no se exponga al frontend
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# ── Seguridad JWT ────────────────────────────────────────────────────────────────
# Generar con: node -e "require('crypto').randomBytes(48).toString('base64')|console.log"
JWT_SECRET=GENERA_CON_openssl_rand_base64_48
# Cifrado en reposo de secretos IMAP de clientes (fallback: JWT_SECRET). No subir a git.
# SECRETS_ENCRYPTION_KEY=GENERA_CON_openssl_rand_base64_48
JWT_REFRESH_SECRET=GENERA_CON_openssl_rand_base64_48_DIFERENTE
# Access token: 8h evita cortes en TPV; el cliente también renueva en segundo plano.
# (15m es demasiado corto para tablets que solo refrescan al fallar una API.)
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Auth epoch (invalidación de sesiones) ─────────────────────────────────────
# Subir este número solo cuando QUIERAS forzar que todos vuelvan a login
# (por ejemplo, tras un deploy grande).
AUTH_EPOCH=0

# ── Bloqueo login empresa (abuso) ────────────────────────────────────────────────
# Trabajadores (invitados): NUNCA se bloquean. En desarrollo el bloqueo está off.
# En producción: activo para cuentas empresa. Forzar off: LOGIN_LOCKOUT_ENABLED=false
# LOGIN_LOCKOUT_ENABLED=true
# Primer umbral real en código: máximo(8, MAX_LOGIN_ATTEMPTS); default intentos 12, 2 min
MAX_LOGIN_ATTEMPTS=12
LOCK_DURATION_MINUTES=2
# Intentos de contraseña por email+IP en 15 min (los aciertos no cuentan)
LOGIN_RATE_LIMIT_MAX=25

# ── API Tokens (A-09) ────────────────────────────────────────────────────────────
# Máximo de días de expiración permitidos al crear/rotar un token (0 = sin límite)
API_TOKEN_MAX_EXPIRY_DAYS=365

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma (sin espacios)
# Producción típica Vertial (vertialapp.com) + localhost/dev según necesitéis
ALLOWED_ORIGINS=https://vertialapp.com,https://www.vertialapp.com,https://api.vertialapp.com
# Opcional: permitir subdominios HTTPS (ej. staging.tudominio.com) sin listarlos uno a uno
# ALLOWED_ORIGIN_SUFFIXES=tudominio.com

# ── Email ─────────────────────────────────────────────────────────────────────────
# Recuperación de contraseña y correos transaccionales usan sendEmail() en el servidor.
# Copia el bloque que uses a .env / .env.development (no subas secretos al repo).
#
# Opción recomendada en local: Gmail con contraseña de aplicación (no la contraseña normal).
# Cuenta de ejemplo con “notas” en el nombre → cámbiala por tu Gmail real.
#
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vertial.noreply@gmail.com
# Contraseña de aplicación de 16 caracteres (Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación). No uses comillas.
SMTP_PASS=zequpbcbsvnbjvtj
EMAIL_FROM=vertial.noreply@gmail.com
EMAIL_FROM_NAME=Vertial
# Reply-To / contacto público: mismo noreply hasta tener buzón de dominio
EMAIL_REPLY_TO=vertial.noreply@gmail.com
PUBLIC_SUPPORT_EMAIL=vertial.noreply@gmail.com
#
# Opción 1 (alternativa): Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
# EMAIL_FROM=noreply@tudominioverificado.com
#
# Desactivar envíos (útil en dev/staging cuando no quieres mandar correos reales)
# EMAIL_DISABLED=true
#
# Buzón de alertas operativas (registros, infra, bugs, afiliados) — solo destino, nunca From
ALERTS_ADMIN_EMAIL=elnootas2.0@gmail.com
BUG_REPORT_EMAIL=elnootas2.0@gmail.com
AFFILIATE_EMAIL=elnootas2.0@gmail.com
# Código OTP de login admin (no se muestra en la web a qué buzón va)
ADMIN_LOGIN_OTP_EMAIL=elnootas2.0@gmail.com
DEFAULT_CONTACT_EMAIL=vertial.noreply@gmail.com
# Siempre activas (dev y prod): altas, plan, trial por acabar/acabado, pago fallido,
# suspensión, fallo envío invitación trabajador, bugs, afiliados…
# Solo producción (RAM, Couch, backup, pico 5xx, resumen diario): no en npm run dev.
# Forzar infra en local (no recomendado): ALERTS_OPS_IN_DEV=true
# Apagar todas las alertas admin: ALERTS_ADMIN_ENABLED=false
#
# Umbrales infra (opcional, VPS ~8 GB)
# ALERT_RSS_MB=1500
# ALERT_HEAP_MB=1100
# ALERT_DISK_FREE_GB=3
# ALERT_5XX_THRESHOLD=15
# ALERT_BACKUP_MAX_AGE_HOURS=26
# Resumen diario (prod): primer envío tras delay, luego cada 24h
# ALERT_DAILY_DIGEST_DELAY_MS=900000
# ALERT_DAILY_DIGEST_INTERVAL_MS=86400000
# Secreto opcional para firmar enlaces de aceptar/rechazar desde el email (fallback: JWT_SECRET)
# AFFILIATE_ACTION_SECRET=...

# ── Activación manual por transferencia (cuentas nuevas) ───────────────────────
# Pantalla /saas/subscription. El cliente avisa del pago; el admin activa.
# Las alertas de “pago avisado” van a ALERTS_ADMIN_EMAIL (mismo buzón que el resto).
VERTIAL_TRANSFER_IBAN=ES66 2100 3323 0421 0078 3688
VERTIAL_TRANSFER_HOLDER=Uriel Arnau Ruiz
# VERTIAL_TRANSFER_BANK=CaixaBank
# VERTIAL_TRANSFER_BIC=

# ── Pasarela de pago (MONEI) — suscripciones Vertial ─────────────────────────────
# Guía paso a paso: docs/MONEI-IMPLEMENTACION.md
# Comprobar config antes del deploy: npm run monei:preflight
#
# Modo test (sandbox) o live (cobros reales):
MONEI_MODE=test
#
# Desarrollo local: true = "Ir a pagar" activa el plan SIN pasarela (no usar en prod).
SKIP_MONEI_SUBSCRIPTION=true
#
# Solo desarrollo: saltar verificación de firma webhook (NUNCA en producción).
# MONEI_WEBHOOK_SKIP_VERIFY=true
#
# Claves API MONEI (Dashboard → Settings → API). Acepta TOKEN_* o MONEI_*:
TOKEN_API_KEY_TEST=
TOKEN_API_KEY=
# Alias alternativos (misma clave):
# MONEI_API_KEY_TEST=
# MONEI_API_KEY=
#
# Account ID (UUID) si tu cuenta MONEI lo requiere en MONEI-Account-ID:
TOKEN_API_ID_TEST=
TOKEN_API_ID=
# MONEI_ACCOUNT_ID_TEST=
# MONEI_ACCOUNT_ID=
#
# Tolerancia de reloj para webhooks (segundos, default 300):
# MONEI_WEBHOOK_TOLERANCE_SECONDS=300
#
# ── MONEI Connect (alta comercios vía promo vertial) ─────────────────────────────
# Enlace: https://dashboard.monei.com/signup?promo=vertial
# Partner API keys (admin.monei.com) — pueden coincidir con TOKEN_API_KEY si aplica:
MONEI_PARTNER_PROMO=vertial
# MONEI_PARTNER_SIGNUP_URL=https://dashboard.monei.com/signup
# MONEI_PARTNER_API_KEY_TEST=
# MONEI_PARTNER_API_KEY=
# Webhook partner (configurar en admin.monei.com → Settings → Webhooks):
#   {APP_URL}/api/monei-connect/webhook
# Eventos mínimos: account.pending, account.approved, account.activated, account.rejected

# ── Google Sign-In (GIS) ──────────────────────────────────────────────────────
# MISMO Client ID en ambos (cliente OAuth tipo "Web application").
#
# Producción suele fallar si solo defines GOOGLE_CLIENT_ID en el servidor:
#   → El FRONT se construye con `npm run build`: ahí Vite INCUSTA VITE_GOOGLE_CLIENT_ID.
#   → Sin esa variable EN EL MOMENTO DEL BUILD, el botón de Google no funciona en prod.
#
# Backend (.env del servidor): GOOGLE_CLIENT_ID (+ GOOGLE_CLIENT_SECRET si tu proyecto lo exige).
# Pipeline / máquina del build: export VITE_GOOGLE_CLIENT_ID=... mismo valor antes de npm run build.
#
# Google Cloud Console → credencial Web → Orígenes JavaScript autorizados:
#   https://tudominio.com , https://www.tudominio.com , http://localhost:3015 (dev), etc.
# (exactamente el origen del navegador, incluido https y puerto si lo hay).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sign in with Apple (web + iOS) ────────────────────────────────────────────
# iOS usa Bundle ID; la web usa un Services ID distinto (Apple Developer → Services IDs).
# APPLE_CLIENT_ID=com.vertial.app
# APPLE_SERVICES_ID=com.vertial.app.web
# Build front (mismo Services ID que APPLE_SERVICES_ID):
# VITE_APPLE_CLIENT_ID=com.vertial.app.web
# Return URL del Services ID (sin barra final), p. ej. https://vertialapp.com
# VITE_APPLE_REDIRECT_URI=https://vertialapp.com

# ── Google Maps / Places Autocomplete ─────────────────────────────────────────
# Clave API con Places API (New) habilitada.
# Obtener en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# ── Catálogo / delivery: borrar productos ────────────────────────────────────────
# Opcional. Si defines un PIN, borrar artículos del catálogo (Delivery Catálogo y Catálogo genérico)
# solo se permite tras introducir ese PIN. Va embebido en el bundle del front: sirve contra borrados
# accidentales, no como control de seguridad fuerte. Si lo dejas vacío, hay que escribir el nombre exacto
# del producto (o la frase BORRADO MASIVO para borrar por filtro en Delivery Catálogo).
# VITE_CATALOG_DELETE_PIN=

# ── URL pública ───────────────────────────────────────────────────────────────────
# Local típico: http://localhost:3015 (o lo que definas en .env.development).
APP_URL=https://vertialapp.com
# Al tener dominio/API definitivos: actualiza APP_URL, VITE_API_URL (p. ej. /api detrás de Nginx) y ALLOWED_ORIGINS;
# rebuild del front (VITE_*). CouchDB en red pública: COUCHDB_URL=https://host… y TLS;
# preferible que Couch solo sea accesible desde el servidor (127.0.0.1) y no exponerlo.

# ── Estabilidad producción (5+ usuarios navegando a la vez) ─────────────────────
# Copiar al .env del VPS. Valores por defecto del código si no se definen.
# NODE_MAX_OLD_SPACE_MB=1024
# BURST_LIMIT_MAX=150
# BURST_LIMIT_WINDOW_MS=10000
# PLAN_TRIAL_MAX_PER_MIN=400
# PLAN_PRO_MAX_PER_MIN=1000
# SSE_MAX_CONNECTIONS_PER_USER=3
# HTTP_MAX_CONNECTIONS=500
# HTTP_HEADERS_TIMEOUT_MS=3600000
# SHUTDOWN_TIMEOUT_MS=15000

# ── Push nativo — pantalla de bloqueo (móvil bloqueado / app en segundo plano) ─
# iOS (APNs): Key .p8 de Apple + Key ID + Team ID. Sin esto el iPhone no avisa.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.vertial.app
# APNS_KEY_PATH=/ruta/AuthKey_XXXX.p8
# APNS_KEY_CONTENT=
# true = TestFlight / App Store. false = debug Xcode (sandbox).
# APNS_PRODUCTION=true
# Android (FCM HTTP v1): cuenta de servicio Firebase (JSON).
# En la consola: Configuración → Cloud Messaging → Administrar cuentas de servicio
# → crear clave JSON. En el VPS:
# FCM_SERVICE_ACCOUNT_PATH=/opt/vertial/secrets/firebase-adminsdk.json
# o FCM_SERVICE_ACCOUNT_JSON=<contenido o base64 del JSON>
# FCM_PROJECT_ID=  (opcional; suele venir en el JSON como project_id)
# Legacy (solo si aún tienes Server key): FIREBASE_SERVER_KEY=
# También hace falta google-services.json en android/app/ al compilar el APK.
# FIREBASE_SERVER_KEY=
# FCM_SERVER_KEY=
# Web Push (PWA/navegador), aparte del móvil nativo:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@vertialapp.com

# ── Uber Eats Marketplace (OAuth) — prod vertialapp.com / uriel@admin.com ─────
# Sin túnel: redirect HTTPS público. OAuth API limitado a uriel@admin.com.
# No usar la cuenta del cliente vivo. Redirect EXACTO en portal Uber Setup:
# UBER_EATS_CLIENT_ID=
# UBER_EATS_CLIENT_SECRET=
# UBER_EATS_ENV=sandbox
# UBER_EATS_REDIRECT_URI=https://vertialapp.com/saas/vertical/delivery/integraciones
# UBER_EATS_SCOPES="eats.pos_provisioning"
# (eats.store / eats.order van en client_credentials, no en este OAuth de usuario)