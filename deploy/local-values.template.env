# Copiar a: deploy/local-values.env (ese archivo NO se sube a git)
# Rellena solo lo que uses. No commitees valores reales.

# --- Deploy desde tu PC (npm run deploy:frontend | deploy:backend) ---
DEPLOY_USER=
DEPLOY_HOST=
DEPLOY_DIST_PATH=/opt/vertial/Vertial/dist
REPO_PATH_ON_VPS=/opt/vertial/Vertial
PM2_BACKEND_NAME=vertial-backend
# Opcional: clave SSH (si no usas agente)
# SSH_IDENTITY_FILE=C:/Users/TU/.ssh/id_ed25519

# --- Alias opcionales (equivalentes a DEPLOY_*) ---
# SSH_USER=
# VPS_IP=

# --- Backend (PM2 / proceso Node) ---
NODE_ENV=production
PORT=3000
APP_URL=https://vertialapp.com
ALLOWED_ORIGINS=https://vertialapp.com,https://www.vertialapp.com

COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
COUCHDB_DB=vertial

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple web (Services ID ≠ Bundle ID iOS)
# APPLE_CLIENT_ID=com.vertial.app
# APPLE_SERVICES_ID=com.vertial.app.web

# --- Build frontend (npm run build): mismo contenido en .env.production local o export ---
VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=com.vertial.app.web
# VITE_APPLE_REDIRECT_URI=https://vertialapp.com
VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=

# --- Smoke test pre-deploy (npm run smoke:saas | check:saas) ---
# Cuenta de PRUEBA. uriel@admin.com NO: ese email es solo login manual (OTP).
# SMOKE_SAAS_EMAIL=
# SMOKE_SAAS_PASSWORD=
# API a probar: local npm run backend:dev → http://127.0.0.1:3001
# En deploy frontend desde tu PC → https://vertialapp.com (backend ya desplegado)
# VERIFY_API_BASE=https://vertialapp.com
# SMOKE_SAAS_MIN_STORES=1

# --- Estabilidad producción (5+ usuarios concurrentes) — añadir también al .env del VPS ---
# NODE_MAX_OLD_SPACE_MB=1024
# BURST_LIMIT_MAX=150
# PLAN_TRIAL_MAX_PER_MIN=400
# SSE_MAX_CONNECTIONS_PER_USER=3
# HTTP_MAX_CONNECTIONS=500
