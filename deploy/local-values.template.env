# Copiar a: deploy/local-values.env (ese archivo NO se sube a git)
# Rellena solo lo que uses. No commitees valores reales.

# --- Deploy desde tu PC (npm run deploy:frontend | deploy:backend) ---
DEPLOY_USER=
DEPLOY_HOST=
DEPLOY_DIST_PATH=/var/www/vertial/dist
REPO_PATH_ON_VPS=/ruta/al/repo-en-el-vps
PM2_BACKEND_NAME=udar-backend
# Opcional: clave SSH (si no usas agente)
# SSH_IDENTITY_FILE=C:/Users/TU/.ssh/id_ed25519

# --- Alias opcionales (equivalentes a DEPLOY_*) ---
# SSH_USER=
# VPS_IP=

# --- Backend (PM2 / proceso Node) ---
NODE_ENV=production
PORT=3000
APP_URL=https://vertialapp.com
ALLOWED_ORIGINS=https://vertialapp.com,https://www.vertialapp.com

COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASSWORD=
COUCHDB_DB=vertial

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Build frontend (npm run build): mismo contenido en .env.production local o export ---
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=

# --- Estabilidad producción (5+ usuarios concurrentes) — añadir también al .env del VPS ---
# NODE_MAX_OLD_SPACE_MB=1024
# BURST_LIMIT_MAX=150
# PLAN_TRIAL_MAX_PER_MIN=400
# SSE_MAX_CONNECTIONS_PER_USER=3
# HTTP_MAX_CONNECTIONS=500
