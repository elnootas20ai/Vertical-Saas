{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:3016": "vite --port 3016 --strictPort",
    "dev:3017": "vite --port 3017 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node index.js",
    "backend": "node index.js",
    "backend:dev": "cross-env NODE_ENV=development node index.js",
    "backend:staging": "cross-env NODE_ENV=staging node index.js",
    "backend:prod": "cross-env NODE_ENV=production node index.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:update": "npx cap update",
    "monitor": "node scripts/monitor.mjs",
    "print-bridge": "node scripts/vertial-print-bridge.mjs",
    "couch:check": "node scripts/verify-couch.mjs",
    "couch:up": "docker compose -f deploy/docker-compose.couch-local.yml --env-file .env up -d",
    "couch:recover-admin": "node scripts/create-admin.js",
    "couch:bootstrap-system": "node scripts/couch-bootstrap-system.mjs",
    "saas:bootstrap": "node scripts/bootstrap-saas-login.js",
    "create-admin": "node scripts/create-admin.js",
    "accounts:delete": "node scripts/delete-test-accounts.mjs",
    "accounts:list": "node scripts/delete-test-accounts.mjs --list",
    "accounts:list-duplicates": "node scripts/delete-test-accounts.mjs --list-duplicates",
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "deploy:backend": "node scripts/deploy-backend.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "deploy:diagnose": "node scripts/remote-diagnose.mjs",
    "deploy:deep-diagnose": "node scripts/remote-deep-diagnose.mjs",
    "deploy:fix-dist": "node scripts/remote-fix-dist-perms.mjs",
    "smoke:saas": "node scripts/smoke-saas.mjs",
    "check:saas": "npm run build && node scripts/smoke-saas.mjs"
  },
