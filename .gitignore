# Entorno y secretos — NUNCA versionar
.env
.env.*
!.env.example

# Dependencias
node_modules/
.pnp
.pnp.js

# Build (dist se versiona para despliegue directo al VPS vía git pull)
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Cobertura y tests
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Cache
.eslintcache
.cache/
.parcel-cache/

# Firma release Android — NUNCA versionar (guarda copia de seguridad fuera del repo)
android/keystore.properties
android/*.keystore
*.jks
android/app/google-services.json
**/firebase-adminsdk*.json
**/vertial-firebase*.json

# Capacitor / nativo (artefactos locales; las carpetas android/ e ios/ sí se versionan)
android/.gradle/
android/app/build/
android/local.properties
android/captures/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
dist-android/
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Plugin data (agent persistence)
.plugin-data/

# Borradores / snapshots locales del canvas (no son parte del producto)
src/app/components/saved/

# Payment gateway keys (secrets)
.gateway-keys.json

# Valores reales de despliegue (copia desde deploy/local-values.template.env)
deploy/local-values.env

# Backups locales CouchDB (no versionar volúmenes de datos)
backups/*.json.gz
backups/_extract_tmp/

# Script local de repro iOS (credenciales de dev)
scripts/repro-native-ios.mjs
